{
	"schemaVersion": 1,
	"id": "steppenomads",
	"version": "${version}",
	"name": "Steppe Nomads",
	"description": "Simple mod adding new structures to Plains biome, new mob interactions and also adding new tree",
	"authors": [
		"EnterYT"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "MIT",
	"icon": "assets/steppenomads/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"enter.steppenomads.SteppeNomads"
		],
		"client": [
			"enter.steppenomads.client.SteppeNomadsClient"
		],
		"fabric-datagen": [
			"enter.steppenomads.client.SteppeNomadsDataGenerator"
		]
	},
	"mixins": [
		"steppenomads.mixins.json",
		{
			"config": "steppenomads.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}